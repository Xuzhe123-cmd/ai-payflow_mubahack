# This environment variable is used in Production and Preview environments to deploy your Convex project
# This variable is not needed in development.
# You can create a Production or Preview deploy key at https://dashboard.convex.dev/project/settings#production-deploy-keys
CONVEX_DEPLOY_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Workers AI — the treasury decision engine.
#
# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_: the token would be shipped
# to the browser. The LLM call happens exclusively in app/api/analyze/route.ts.
#
# Without these the app still runs, but every invoice is escalated by the
# safety fallback and clearly labelled as such — it is not an AI demo.
#
# The token needs the "Workers AI - Read" permission.
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: routes calls through AI Gateway for logging and caching.
CLOUDFLARE_AI_GATEWAY_ID=

# Optional: must be a model that supports Workers AI JSON Mode.
# https://developers.cloudflare.com/workers-ai/features/json-mode/
PAYFLOW_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ---------------------------------------------------------------------------
# Engine mode — how the decision is produced.
#
#   live      (default) call Workers AI for every invoice
#   recorded  replay the captured responses in tests/fixtures/llm
#
# "recorded" exists for presentations: the free Workers AI tier has a daily
# neuron allowance, and a demo should not depend on it. The recordings are
# verbatim model output replayed through the same validation guard, and the
# interface labels them "Recorded" rather than passing them off as a live call.
#
# Recording is never selected automatically. A live call that fails still
# escalates to the safety fallback, because substituting a recording for a
# failed call would mean claiming the AI ran when it did not.
#
# Refresh the recordings with: npm run record:llm
# ---------------------------------------------------------------------------
PAYFLOW_ENGINE=live
